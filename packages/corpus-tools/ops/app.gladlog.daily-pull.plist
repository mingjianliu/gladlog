<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.gladlog.daily-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/mingjianliu/code/gladlog/packages/corpus-tools &amp;&amp; npm run -s logs:daily</string>
  </array>
  <!-- Once a day at 21:00 local: the upstream quota resets at 00:00 UTC, which is
       20:00 Toronto in summer and 19:00 in winter, so 21:00 is past both. A run
       missed while the laptop was asleep is made up at the next wake (launchd,
       unlike cron). -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key>
  <string>/Users/mingjianliu/code/gladlog-eval-private/downloads/daily-pull/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mingjianliu/code/gladlog-eval-private/downloads/daily-pull/launchd.log</string>
</dict>
</plist>
