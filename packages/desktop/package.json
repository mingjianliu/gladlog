{
  "name": "@gladlog/desktop",
  "version": "0.1.32",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:ui": "vite --config dev/vite.config.mts",
    "build:ui": "vite build --config dev/vite.config.mts",
    "preview:ui": "vite preview --config dev/vite.config.mts",
    "build": "electron-vite build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:vision": "tsx scripts/verifyVision.ts",
    "learning:scan": "tsx scripts/learningScan.ts",
    "recorder:gatecheck": "tsx scripts/obsGateCheck.ts",
    "recorder:headroom": "tsx scripts/headroomBaseline.ts",
    "test:visual": "playwright test -c qa/playwright.config.ts --project=visual --project=visual-1440 --project=visual-1920 --project=visual-2560",
    "test:visual:smoke": "playwright test -c qa/playwright.config.ts --project=visual --project=visual-1440 --project=visual-1920 --project=visual-2560 --ignore-snapshots",
    "test:e2e": "electron-vite build && playwright test -c qa/playwright.config.ts --project=e2e",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@fontsource/inter": "^5.3.0",
    "@gladlog/analysis": "0.0.1",
    "@gladlog/parser": "0.0.1",
    "@gladlog/parser-compat": "0.0.1",
    "d3-scale": "^4.0.2",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.2.0",
    "obs-websocket-js": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-scale": "^4.0.9",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "build": {
    "appId": "com.gladlog.desktop",
    "publish": {
      "provider": "github",
      "owner": "mingjianliu",
      "repo": "gladlog"
    },
    "productName": "gladlog",
    "electronVersion": "38.8.6",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "afterSign": "build/afterSign.cjs",
    "extraResources": [
      {
        "from": "../corpus-tools/data/reference_vectors.json",
        "to": "reference_vectors.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}.Setup.${version}.${ext}"
    }
  }
}
